# Copy to .env. Everything is optional: without a key Haulmind runs on the deterministic
# offline stub provider (no network), which is enough for `make demo`, tests and replay evals.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model names change over time; check `make models` for what your key can reach.
LLM_MODEL_TRIAGE=gemini-3.5-flash-lite
LLM_MODEL_PLANNER=gemini-3.5-flash

# auto | gemini | openai | stub
# auto = gemini if GEMINI_API_KEY is set, else openai if LLM_API_KEY is set, else the stub.
LLM_PROVIDER=auto

# OpenAI-compatible provider: Groq, Mistral, OpenRouter, Ollama, GitHub Models, Cerebras, ...
# Set LLM_PROVIDER=openai (or leave auto with no GEMINI_API_KEY) and change the model names
# above to ones the provider serves (`make models` lists them). Groq's free tier needs no card.
#   Groq        https://api.groq.com/openai/v1   triage openai/gpt-oss-20b, planner openai/gpt-oss-120b
#   Mistral     https://api.mistral.ai/v1        triage mistral-small-latest, planner mistral-medium-latest
#   OpenRouter  https://openrouter.ai/api/v1     any model id ending in ":free"
#   Ollama      http://127.0.0.1:11434/v1        no key needed
LLM_API_KEY=
LLM_API_BASE=https://api.groq.com/openai/v1
# Reasoning effort for OpenAI-compatible reasoning models (low|medium|high). Unset = low for gpt-oss.
LLM_REASONING_EFFORT=
# live | replay | off   (replay = never touch the network, fail on cache miss)
LLM_CACHE_MODE=live

# Conservative free-tier limits. Requests per minute / per day, per model role.
LLM_RPM_TRIAGE=5
LLM_RPM_PLANNER=5
LLM_RPD_TRIAGE=800
LLM_RPD_PLANNER=200

# Simulator
SIM_SEED=42
SIM_FLEET_SIZE=25
SIM_HOURS=48
# simulated seconds per real second while streaming (0 = as fast as possible)
SIM_SPEED=120
SIM_AUTOSTART=true

# Agent configuration (also used for ablations)
AGENT_MODE=multi
RAG_ENABLED=true
MEMORY_ENABLED=true

# Ports
WEB_PORT=8000
MCP_PORT=8765

# Logging
LOG_LEVEL=INFO
LOG_JSON=false
